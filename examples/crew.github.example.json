{
  "id": "demo",
  "name": "Demo crew",
  "voice": {"name": "Shopfloor", "style": "plain"},
  "dryRun": true,
  "paused": false,
  "autoRecommend": "questions",
  "limits": {
    "maxParallel": 2,
    "maxFixRounds": 3,
    "maxNewPerTick": 2,
    "buildMaxMinutes": 180,
    "tickMaxMinutes": 60
  },
  "schedule": {"start": "07:00", "everyHours": 3, "until": "22:00", "weekdaysOnly": false},
  "repos": {"app": {"github": "owner/app", "base": "main", "path": "~/code/app"}},
  "protectedBranches": ["main"],
  "tracker": {
    "type": "github",
    "github": {
      "repo": "owner/app",
      "label": "shopfloor",
      "assignee": null,
      "holdLabels": ["hold"],
      "states": {"inProgress": "shopfloor:in-progress", "review": "shopfloor:review"}
    },
    "mayMove": ["todo->inProgress", "inProgress->review"]
  },
  "chat": {
    "type": "github",
    "github": {"owner": "your-login"}
  },
  "gitFlow": {"type": "pr-only", "testBranch": null, "mergeDenyPaths": []},
  "policyPacks": [],
  "guard": {"offLimits": [], "secretFiles": []}
}
